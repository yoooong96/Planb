<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.itinerary.report">

    <insert id="insertReport"
        parameterType="dto.report.ReportDto"
        useGeneratedKeys="true"
        keyProperty="reportId"
        keyColumn="report_id">

        INSERT INTO TB_REPORT (
            reporter_user_id,
            target_type,
            target_id,
            target_user_id,
            reason_id,
            detail,
            status,
            action_type
        )
        VALUES (
            #{reporterUserId},
            'ITINERARY',
            #{targetId},
            #{targetUserId},
            #{reasonId},
            #{detail, jdbcType=VARCHAR},
            'PENDING',
            'NONE'
        )

    </insert>

</mapper>