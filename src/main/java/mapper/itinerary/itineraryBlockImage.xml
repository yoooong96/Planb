<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.itinerary.itineraryBlockImage">
    <!-- 블록 이미지 저장 -->
    <insert id="insertItineraryBlockImage"
            parameterType="dto.itinerary.ItineraryBlockImageDto"
            useGeneratedKeys="true"
            keyProperty="imageId"
            keyColumn="image_id">

        INSERT INTO TB_ITINERARY_BLOCK_IMAGE (
            block_id,
            image_url,
            image_order
        )
        VALUES (
            #{blockId},
            #{imageUrl},
            #{imageOrder}
        )

    </insert>


    <!-- 특정 블록의 이미지 조회 -->
    <select id="selectItineraryBlockImages"
            parameterType="long"
            resultType="itineraryBlockImage">

        SELECT
            image_id,
            block_id,
            image_url,
            image_order
        FROM TB_ITINERARY_BLOCK_IMAGE
        WHERE block_id = #{blockId}
        ORDER BY image_order ASC

    </select>


    <!-- 이미지 수정 -->
    <update id="updateItineraryBlockImage"
            parameterType="dto.itinerary.ItineraryBlockImageDto">

        UPDATE TB_ITINERARY_BLOCK_IMAGE
        SET
            image_url = #{imageUrl},
            image_order = #{imageOrder}
        WHERE image_id = #{imageId}
          AND block_id = #{blockId}

    </update>


    <!-- 블록의 이미지 전체 삭제 -->
    <delete id="deleteItineraryBlockImagesByBlockId"
            parameterType="long">

        DELETE FROM TB_ITINERARY_BLOCK_IMAGE
        WHERE block_id = #{blockId}

    </delete>

</mapper>
