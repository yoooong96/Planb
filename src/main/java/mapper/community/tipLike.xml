<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.community.tipLike">

	<!-- 좋아요 등록 -->
	<insert id="insertTipLike" parameterType="dto.community.TipLikeDto">
	    INSERT INTO TB_TIP_LIKE (tip_id, user_id) VALUES (#{tipId}, #{userId})
	</insert>
	
	<!-- 좋아요 여부 조회 -->
	<select id="selectTipLike" parameterType="dto.community.TipLikeDto" resultType="dto.community.TipLikeDto">
	    SELECT tip_id AS tipId, user_id AS userId, created_at AS createdAt
	    FROM TB_TIP_LIKE
	    WHERE tip_id = #{tipId} AND user_id = #{userId}
	</select>
	
	<!-- 좋아요 취소 -->
	<delete id="deleteTipLike" parameterType="dto.community.TipLikeDto">
	    DELETE FROM TB_TIP_LIKE
	    WHERE tip_id = #{tipId} AND user_id = #{userId}
	</delete>
	
	<!-- 좋아요 개수 -->
	<select id="selectTipLikeCount" parameterType="long" resultType="int">
	    SELECT COUNT(*)
	    FROM TB_TIP_LIKE
	    WHERE tip_id = #{tipId}
	</select>

</mapper>