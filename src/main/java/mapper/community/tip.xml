<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.community.tip">

	<insert id="insertTip" parameterType="tip" useGeneratedKeys="true" keyProperty="tipId">

	</insert>

	<select id="selectTip" parameterType="Long" resultType="tip">

	</select>
	
	<select id="selectTipList" resultType="tip">
		SELECT * FROM TB_TIP HWERE status = 'ACTIVE' ORDER BY created_at DESC
	</select>
	
	<select id="searchTipByHashtag" parameterType="String" resultType="tip">
		SELECT * FROM TB_TIP WHERE status = 'ACTIVE' AND hashtag LIKE CONCAT('%', #{keyword}, '%') ORDER BY created_at DESC
	</select>

	<update id="updateTip" parameterType="tip">

	</update>

	<delete id="deleteTip" parameterType="Long">

	</delete>

</mapper>